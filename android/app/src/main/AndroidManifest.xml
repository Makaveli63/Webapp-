<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 16 : affichage du compte à rebours en « Live Update » -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="GamingBase"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Liens du site (actu partagée par message…) : ouverts dans l'application.
                 Sans fichier de vérification à la racine du domaine, Android demande de l'autoriser une fois
                 (Réglages du site dans l'appli → « Ouvrir les liens dans l'appli »). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="makaveli63.github.io" android:pathPrefix="/Webapp-" />
            </intent-filter>
        </activity>

        <service
            android:name=".NewsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".LiveCountdown"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".LiveCountdown$Tick"
            android:exported="false" />

        <receiver
            android:name=".NewsJob$Evening"
            android:exported="false" />

        <receiver
            android:name=".PinnedWidget"
            android:exported="false"
            android:label="Mon jeu épinglé">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pinned_info" />
        </receiver>

        <receiver
            android:name=".ReleaseWidget"
            android:exported="false"
            android:label="Prochaine sortie">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_release_info" />
        </receiver>

        <receiver
            android:name=".EpisodesWidget"
            android:exported="false"
            android:label="Mes épisodes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_episodes_info" />
        </receiver>

        <receiver
            android:name=".AnimeWidget"
            android:exported="false"
            android:label="Prochains épisodes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_anime_info" />
        </receiver>

        <receiver
            android:name=".NewsWidget"
            android:exported="false"
            android:label="Dernières actus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_news_info" />
        </receiver>

        <receiver
            android:name=".FreeWidget"
            android:exported="false"
            android:label="Jeux gratuits">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_free_info" />
        </receiver>
    </application>
</manifest>
